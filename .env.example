# Copia este archivo a .env y completa los valores. No subas .env a ningún repositorio.

# Obligatoria. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Hosts desde los que se accede. Si lo publicas en un servidor, agrega su dominio o IP.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes de confianza para formularios (incluye http:// o https://). Si cambias de dominio, actualízalo.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Opcional: crea un administrador al arrancar (si ambos están definidos).
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Base de datos Postgres (Supabase > Connect > Session pooler). Usa una contraseña solo con letras y números.
# Si la dejas vacía, se usa SQLite local.
DATABASE_URL=

# Origen(es) del frontend React que pueden llamar a la API (separados por comas, sin barra final).
# En local, el servidor de Vite. En producción, la URL del sitio estático en Render.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pon 1 cuando el API se sirva por HTTPS (Render): activa cookies seguras y confía en el proxy.
DJANGO_HTTPS=0
